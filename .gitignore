# ── Секреты ───────────────────────────────────────────────────────────
# Главная строка файла. В .env лежат пароль от базы и секретный ключ,
# которым подписываются токены. Попав в репозиторий один раз, они
# остаются в истории навсегда — даже если потом файл удалить.
.env
.env.*
!.env.example

# ── Данные пользователей ──────────────────────────────────────────────
# Выгрузки продаж — это чужие персональные данные. В git им не место
# ни при каких условиях, и файлы там тяжёлые.
data/
uploads/
*.csv
*.xlsx
*.parquet
# ...кроме описания самой папки: оно нужно в репозитории.
!data/README.md

# ── Python ────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Виртуальные окружения
.venv/
venv/

# Poetry lock-файл генерируется автоматически внутри Docker
poetry.lock

# ── Ноутбуки ──────────────────────────────────────────────────────────
.ipynb_checkpoints/

# ── Фронтенд ──────────────────────────────────────────────────────────
node_modules/
.next/
out/
frontend/.env*.local

# ── Среда разработки ──────────────────────────────────────────────────
.idea/
.vscode/
.DS_Store
