# Образец файла настроек. Скопируйте его в .env и подставьте свои значения:
#
#   cp .env.example .env        (в PowerShell: Copy-Item .env.example .env)
#
# Сам .env в git не попадает — в нём лежат пароль от базы и ключ подписи
# токенов. Этот файл, наоборот, нужен в репозитории: по нему новый человек
# (или вы на другом компьютере) поймёт, какие переменные вообще нужны.

# ── База данных ───────────────────────────────────────────────────────
# Эти три значения использует контейнер postgres при первом запуске.
DB_USER=myuser
DB_PASS=change-me
DB_NAME=my_api

# Порт, на котором база будет видна с вашего компьютера.
# Если 5432 уже занят локально установленным PostgreSQL, поставьте 5433.
POSTGRES_PORT=5432

# Строка подключения для приложения. Внутри Docker база доступна по имени
# сервиса `postgres`, а не по localhost — контейнеры видят друг друга по
# именам из docker-compose.yaml.
POSTGRES_DSN=postgresql+asyncpg://myuser:change-me@postgres:5432/my_api

# ── Токены ────────────────────────────────────────────────────────────
# Ключ, которым подписываются JWT. Для разработки подойдёт любая длинная
# строка, для продакшена сгенерируйте новую:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string

# Сколько минут живёт токен доступа.
ACCESS_TOKEN_EXPIRE_MINUTES=60
